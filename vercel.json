{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin-app/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin-app/index.html"
    },
    {
      "source": "/admin-app",
      "destination": "/admin-app/index.html"
    },
    {
      "source": "/admin-app/(.*)",
      "destination": "/admin-app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
