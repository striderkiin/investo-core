# Client-side (VITE_ prefixed vars are bundled into the frontend — never put secrets here)
VITE_APP_ENVIRONMENT=development
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Sentry error monitoring. Leave blank to disable (no-op) — e.g. in local dev.
VITE_SENTRY_DSN=

# Server-side only (edge functions / future backend service). Never prefix with VITE_.
SERVER_API_URL=
PAYMENT_PROVIDER=demo
EMAIL_PROVIDER=
KYC_PROVIDER=

# Server-side secrets (Phase 7+, set only in your Supabase project / hosting
# provider's secret manager — never commit real values)
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
EMAIL_API_SECRET=
KYC_API_SECRET=
